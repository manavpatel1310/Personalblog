---
const links = [
	{ href: "/", label: "Home" },
	{ href: "/blog", label: "Blog" },
	{ href: "/#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur-md dark:border-neutral-700 dark:bg-neutral-900/80">
	<nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between px-4 py-3 sm:flex-nowrap sm:px-6 lg:px-8">
		<a href="/" class="text-lg font-semibold text-gray-900 dark:text-white">Portfolio</a>

		<button
			type="button"
			class="hs-collapse-toggle flex items-center justify-center rounded-lg border border-gray-200 p-2 text-sm font-medium text-gray-800 hover:bg-gray-100 sm:hidden dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800"
			data-hs-collapse="#nav-menu"
			aria-controls="nav-menu"
			aria-label="Toggle navigation"
		>
			<svg class="hs-collapse-open:hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="18" x2="21" y2="18"></line>
			</svg>
			<svg class="hs-collapse-open:block hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M18 6 6 18"></path>
				<path d="m6 6 12 12"></path>
			</svg>
		</button>

		<div id="nav-menu" class="hs-collapse hidden basis-full grow overflow-hidden transition-all duration-300 sm:hs-collapse-open:basis-auto sm:block sm:basis-auto sm:grow-0">
			<div class="mt-4 flex flex-col gap-4 sm:mt-0 sm:flex-row sm:items-center sm:gap-6">
				{
					links.map((link) => (
						<a
							href={link.href}
							class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-neutral-400 dark:hover:text-white"
						>
							{link.label}
						</a>
					))
				}
			</div>
		</div>
	</nav>
</header>
