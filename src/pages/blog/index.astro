---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { hasSanityConfig, sanityClient } from "../../lib/sanity";

type Post = { _id: string; title: string; slug: string; excerpt?: string };

const posts: Post[] = hasSanityConfig
	? await sanityClient!.fetch(
			`*[_type == "post"] | order(publishedAt desc){ _id, title, "slug": slug.current, excerpt }`
		)
	: [];
---

<Layout title="Blog — Portfolio">
	<Header />

	<main class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
		<h1 class="text-3xl font-bold text-gray-900 dark:text-white">Blog</h1>

		{
			!hasSanityConfig && (
				<p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-300">
					Sanity isn't configured yet. Set <code>PUBLIC_SANITY_PROJECT_ID</code> in <code>.env</code> once your
					Studio is deployed to see posts here.
				</p>
			)
		}

		{
			hasSanityConfig && posts.length === 0 && (
				<p class="mt-4 text-sm text-gray-500 dark:text-neutral-400">No posts published yet.</p>
			)
		}

		<div class="mt-8 grid gap-6 sm:grid-cols-2">
			{
				posts.map((post) => (
					<a
						href={`/blog/${post.slug}`}
						class="block rounded-xl border border-gray-200 p-5 transition hover:border-gray-300 hover:shadow-sm dark:border-neutral-700 dark:hover:border-neutral-600"
					>
						<h2 class="font-semibold text-gray-900 dark:text-white">{post.title}</h2>
						{post.excerpt && <p class="mt-2 text-sm text-gray-500 dark:text-neutral-400">{post.excerpt}</p>}
					</a>
				))
			}
		</div>
	</main>

	<Footer />
</Layout>
